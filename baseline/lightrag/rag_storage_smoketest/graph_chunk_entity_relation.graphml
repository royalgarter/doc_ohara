    <node id="Maximum Entropy Principle">
      <data key="d0">Maximum Entropy Principle</data>
      <data key="d1">concept</data>
      <data key="d2">A principle used to find the distribution with the largest entropy subject to constraints.&lt;SEP&gt;A principle that favors uniform distributions when no other information is available.</data>
      <data key="d3">doc-8883a5d4e790630b007c233701f21e64-chunk-002&lt;SEP&gt;doc-8883a5d4e790630b007c233701f21e64-chunk-001</data>

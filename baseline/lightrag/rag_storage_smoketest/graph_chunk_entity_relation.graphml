      <data key="d0">LDA</data>
      <data key="d1">method</data>
      <data key="d2">Latent Dirichlet Allocation, a method used to select features.&lt;SEP&gt;Linear Discriminant Analysis, a method used to select labeled features.&lt;SEP&gt;Latent Dirichlet Allocation.</data>

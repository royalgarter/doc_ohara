    <node id="This paper">
      <data key="d0">This paper</data>
      <data key="d1">content</data>
      <data key="d2">Investigates into the problem of how to leverage prior knowledge robustly in learning models by proposing three regularization terms on top of generalized expectation criteria.</data>
      <data key="d3">doc-8883a5d4e790630b007c233701f21e64-chunk-004</data>
      <data key="d4">qasper_1503.00841.md</data>
      <data key="d5">1785212123</data>
      <data key="d6" />
    </node>
    <node id="Regularization terms">
      <data key="d0">Regularization terms</data>
      <data key="d1">concept</data>
      <data key="d2">Three terms proposed on top of generalized expectation criteria to leverage prior knowledge robustly in learning models.</data>
      <data key="d3">doc-8883a5d4e790630b007c233701f21e64-chunk-004</data>
      <data key="d4">qasper_1503.00841.md</data>
      <data key="d5">1785212123</data>
      <data key="d6" />
    </node>
    <node id="Maximum entropy regularization">
      <data key="d0">Maximum entropy regularization</data>
      <data key="d1">method</data>
      <data key="d2">A regularization term showing strong ability to control unbalance, suitable when no corpus knowledge is available, but assumes uniform category distribution.</data>
      <data key="d3">doc-8883a5d4e790630b007c233701f21e64-chunk-004</data>
      <data key="d4">qasper_1503.00841.md</data>
      <data key="d5">1785212123</data>
      <data key="d6" />
    </node>
    <node id="KL divergence">
      <data key="d0">KL divergence</data>
      <data key="d1">method</data>
      <data key="d2">A regularization method that performs well on unbalanced corpora by utilizing the reference class distribution without assumptions, but requires providing the true class distribution.</data>
      <data key="d3">doc-8883a5d4e790630b007c233701f21e64-chunk-004</data>
      <data key="d4">qasper_1503.00841.md</data>
      <data key="d5">1785212123</data>
